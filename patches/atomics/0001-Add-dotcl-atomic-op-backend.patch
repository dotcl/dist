From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "SANO,Masatoshi" <snmsts@gmail.com>
Date: Fri, 18 Sep 2026 13:36:07 +0900
Subject: [PATCH] Add dotcl atomic-op backend

Add #+dotcl branches to cas/atomic-incf/atomic-decf so atomics loads on
dotcl, and list it in the CAS-place features it supports. CAS compares with
EQL, not EQ: dotcl boxes its numbers, so EQ would stop swapping as soon as a
counter left the small-integer cache.
---
 atomics.lisp | 30 ++++++++++++++++++++----------
 1 file changed, 20 insertions(+), 10 deletions(-)

diff --git a/atomics.lisp b/atomics.lisp
index 2b12ca7..a8a4574 100644
--- a/atomics.lisp
+++ b/atomics.lisp
@@ -14,21 +14,21 @@
    #:defstruct))
 (in-package #:org.shirakumo.atomics)
 
-#+(or allegro clasp ecl lispworks mezzano sbcl cmucl clamiga)
+#+(or allegro clasp ecl lispworks mezzano sbcl cmucl clamiga dotcl)
 (pushnew :atomics-cas-car *features*)
-#+(or allegro ccl clasp ecl lispworks mezzano sbcl cmucl clamiga)
+#+(or allegro ccl clasp ecl lispworks mezzano sbcl cmucl clamiga dotcl)
 (pushnew :atomics-cas-svref *features*)
-#+(or allegro clasp ecl sbcl cmucl)
+#+(or allegro clasp ecl sbcl cmucl dotcl)
 (pushnew :atomics-cas-symbol-plist *features*)
-#+(or allegro clasp ecl lispworks mezzano sbcl cmucl clamiga)
+#+(or allegro clasp ecl lispworks mezzano sbcl cmucl clamiga dotcl)
 (pushnew :atomics-cas-symbol-value *features*)
-#+(or allegro clasp ecl lispworks mezzano sbcl cmucl clamiga)
+#+(or allegro clasp ecl lispworks mezzano sbcl cmucl clamiga dotcl)
 (pushnew :atomics-cas-slot-value *features*)
 #+(or allegro)
 (pushnew :atomics-cas-memref *features*)
-#+(or allegro ccl clasp ecl lispworks mezzano sbcl cmucl clamiga)
+#+(or allegro ccl clasp ecl lispworks mezzano sbcl cmucl clamiga dotcl)
 (pushnew :atomics-cas-struct-slot *features*)
-#+(or allegro ccl clasp ecl lispworks mezzano sbcl cmucl clamiga)
+#+(or allegro ccl clasp ecl lispworks mezzano sbcl cmucl clamiga dotcl)
 (pushnew :atomics-cas-special-var *features*)
 #+(or clasp ecl lispworks mezzano sbcl cmucl)
 (pushnew :atomics-cas-custom *features*)
@@ -79,7 +79,13 @@ the necessary operators, please file an issue at
   #+clamiga
   (let ((tmp (gensym "OLD")))
     `(let ((,tmp ,old)) (eq ,tmp (mp:compare-and-swap ,place ,tmp ,new))))
-  #-(or allegro ccl clasp ecl lispworks mezzano sbcl cmucl clamiga)
+  ;; EQL, not EQ as the other arms use: dotcl's COMPARE-AND-SWAP compares with
+  ;; EQL because its numbers are boxed, so an EQ test here would start failing
+  ;; silently as soon as a counter left the small-integer cache.
+  #+dotcl
+  (let ((tmp (gensym "OLD")))
+    `(let ((,tmp ,old)) (eql ,tmp (dotcl:compare-and-swap ,place ,tmp ,new))))
+  #-(or allegro ccl clasp ecl lispworks mezzano sbcl cmucl clamiga dotcl)
   (no-support 'CAS))
 
 (defmacro atomic-incf (place &optional (delta 1))
@@ -101,7 +107,9 @@ the necessary operators, please file an issue at
   `(mp:atomic-incf ,place ,delta)
   #+clamiga
   `(mp:atomic-incf ,place ,delta)
-  #-(or allegro ccl clasp ecl lispworks mezzano sbcl cmucl clamiga)
+  #+dotcl
+  `(dotcl:atomic-incf ,place ,delta)
+  #-(or allegro ccl clasp ecl lispworks mezzano sbcl cmucl clamiga dotcl)
   (no-support 'atomic-incf))
 
 (defmacro atomic-decf (place &optional (delta 1))
@@ -123,7 +131,9 @@ the necessary operators, please file an issue at
   `(mp:atomic-decf ,place ,delta)
   #+clamiga
   `(mp:atomic-decf ,place ,delta)
-  #-(or allegro ccl clasp ecl lispworks mezzano sbcl cmucl clamiga)
+  #+dotcl
+  `(dotcl:atomic-decf ,place ,delta)
+  #-(or allegro ccl clasp ecl lispworks mezzano sbcl cmucl clamiga dotcl)
   (no-support 'atomic-decf))
 
 (defmacro atomic-pop (place)
